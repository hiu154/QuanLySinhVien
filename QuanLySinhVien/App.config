<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="QuanLySinhVienConnection" 
         connectionString="Server=.;Database=QuanLySinhVienDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5;" 
         providerName="Microsoft.Data.SqlClient" />
